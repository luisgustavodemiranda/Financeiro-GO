# Referência: esta fase lê variáveis do processo, não carrega .env automaticamente.
HTTP_HOST=127.0.0.1
HTTP_PORT=8081
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_SHUTDOWN_TIMEOUT=10s
# memory mantém o comportamento de estudo sem banco; postgres exige conexão explícita.
PERSISTENCE=memory
DATABASE_TIMEOUT=10s
# Informe a URL apenas no ambiente local; nunca versione credenciais.
# Banco permitido: financeiro_go (aplicação) ou financeiro_go_test (testes).
FINANCEIRO_DATABASE_URL=
# Alternativa à URL. Se a URL estiver preenchida, estas variáveis são ignoradas.
# Host, usuário e senha devem ser informados somente no ambiente local.
DB_HOST=
DB_PORT=5432
DB_NAME=financeiro_go
DB_USER=
DB_PASSWORD=
# Padrão require; use disable explicitamente quando necessário no servidor local.
DB_SSLMODE=require
# Integração é opt-in e não aplica migrations automaticamente.
FINANCEIRO_TEST_DATABASE_URL=
